@model TeslaMAMA.Models.RideSearchViewModel
@{
    ViewData["Title"] = "Home";
}
<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />

<main class="hero">
    <div class="hero-grid">
    <section>
        <div class="badge in d1"><i></i>Smarter shared travel</div>
        <h1 class="in d2">Your journey.<span>Shared smarter.</span></h1>
        <p class="lede in d3">
            Discover a smarter way to travel across Dhaka. Share compatible routes, make the most of every seat,
            and enjoy a more convenient journey with TeslaMAMA.
        </p>

        <div class="actions in d4">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="btn-main" asp-controller="Passenger" asp-action="Book">
                    Explore ride pooling
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </a>
            }
            else
            {
                <a class="btn-main" asp-controller="Rides" asp-action="Book">
                    Find your next ride
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </a>
                <a class="btn-ghost" asp-controller="Account" asp-action="Register">Get started</a>
            }
        </div>

        <p class="tagline in d5">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="#1b6b50" aria-hidden="true"><path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z" /></svg>
            Built around shared rides and compatible routes
        </p>
    </section>

    <section class="in d6" aria-label="Ride pooling preview">
        <form class="card" asp-controller="Rides" asp-action="Book" method="get" novalidate>
            <div class="top">
                <div>
                    <div class="eyebrow">Your city</div>
                    <div class="city">Dhaka, Bangladesh</div>
                </div>
                <div class="chip"><i></i>Ride pooling</div>
            </div>

            <div class="map">
                <svg class="route" viewBox="0 0 340 250" fill="none" aria-hidden="true">
                    <path class="flow" d="M30 80 C 160 60, 150 190, 310 180" stroke="#a8e6cf" stroke-opacity=".45" stroke-width="2" stroke-linecap="round" />
                    <path class="trail" pathLength="1" d="M30 80 C 160 60, 150 190, 310 180" stroke="#34d399" stroke-width="3.5" stroke-linecap="round" />
                </svg>

                <div class="place p1"><b>Banani</b>Pickup zone</div>
                <div class="pulse s" style="left:22px;top:72px"></div>
                <div class="pulse d" style="left:302px;top:172px"></div>
                <div class="place p2"><b>Mohakhali</b>Destination zone</div>

                <label class="mini m-pick" style="left:0;top:128px">
                    <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="7" fill="#0f2a21" /><circle cx="12" cy="12" r="2.4" fill="#fff" /></svg>
                    <span class="sr">Pickup location</span>
                    <input asp-for="Pickup" list="areas" placeholder="Pickup location" autocomplete="off" />
                </label>

                <label class="mini m-drop" style="right:0;top:70px">
                    <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="5" width="14" height="14" rx="2.5" fill="#0f2a21" /><rect x="10" y="10" width="4" height="4" fill="#fff" /></svg>
                    <span class="sr">Dropoff location</span>
                    <input asp-for="Dropoff" list="areas" placeholder="Dropoff location" autocomplete="off" />
                </label>

                <datalist id="areas">
                    @foreach (var zone in Model.Zones)
                    {
                        <option value="@zone"></option>
                    }
                </datalist>

                <div class="rick">
                    <svg width="60" height="42" viewBox="0 0 64 44" fill="none" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Cycle rickshaw">
                        <path d="M5 21C5 9 18 5 28 9L34 21Z" fill="#ffcf5a" stroke="#12332a" stroke-width="1.8" />
                        <path d="M6 21H34V31H6Z" fill="#1f8f6a" stroke="#12332a" stroke-width="1.8" />
                        <path d="M16 34 34 31 43 24 50 34M44 24 51 15H56" stroke="#a8e6cf" stroke-width="2.4" />
                        <circle cx="41" cy="9" r="3.6" fill="#ffcf5a" stroke="#12332a" stroke-width="1.4" />
                        <path d="M41 13 44 24M42 17 51 15" stroke="#ffcf5a" stroke-width="2.4" />
                        <g class="wheel"><circle cx="16" cy="34" r="8" stroke="#a8e6cf" stroke-width="2.2" /><path d="M16 26v16M8 34h16" stroke="#a8e6cf" stroke-width="1.2" /></g>
                        <g class="wheel"><circle cx="50" cy="34" r="8" stroke="#a8e6cf" stroke-width="2.2" /><path d="M50 26v16M42 34h16" stroke="#a8e6cf" stroke-width="1.2" /></g>
                    </svg>
                </div>
            </div>

            <div class="idea">
                <div class="eyebrow">The idea</div>
                <h3>One compatible route</h3>
            </div>

            <div class="form-error" asp-validation-summary="All"></div>

            <div class="float">
                <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0f4a37" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg></div>
                <div><b>Travel together</b><span>Share compatible journeys</span></div>
            </div>

            <div class="cta-end">
                <button class="price-btn" type="submit">
                    See prices
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </button>
            </div>
        </form>
    </section>
    </div>
</main>

<section class="tm-trust-strip">
    <div>
        <span class="tm-trust-icon">⌖</span>
        <span>Zone-based journeys</span>
    </div>
    <div>
        <span class="tm-trust-icon">♧</span>
        <span>Shared vehicle capacity</span>
    </div>
    <div>
        <span class="tm-trust-icon">↗</span>
        <span>Individual ride tracking</span>
    </div>
</section>

<section class="tm-section" id="how-it-works">
    <div class="tm-section-heading">
        <span class="tm-eyebrow">SIMPLE BY DESIGN</span>
        <h2>Shared rides, <span>made simple.</span></h2>
        <p>
            From choosing your route to following your ride,
            TeslaMAMA is designed around a straightforward journey.
        </p>
    </div>

    <div class="tm-feature-grid">
        <article class="tm-feature-card">
            <div class="tm-feature-icon">⌖</div>
            <span class="tm-step-number">STEP 01</span>
            <h3>Choose your route</h3>
            <p>
                Select your pickup zone, destination, and the
                number of seats you need.
            </p>
        </article>

        <article class="tm-feature-card">
            <div class="tm-feature-icon">♧</div>
            <span class="tm-step-number">STEP 02</span>
            <h3>Find a compatible pool</h3>
            <p>
                Your ride request can be matched with a suitable
                shared pool when the route and available capacity fit.
            </p>
        </article>

        <article class="tm-feature-card">
            <div class="tm-feature-icon">↗</div>
            <span class="tm-step-number">STEP 03</span>
            <h3>Follow your journey</h3>
            <p>
                Keep track of your individual ride request, its
                status, and your fare.
            </p>
        </article>
    </div>
</section>

<section class="tm-cta-section" id="book-ride">
    <div class="tm-cta-content">
        <span class="tm-eyebrow">YOUR NEXT JOURNEY STARTS HERE</span>
        <h2>Make your next ride<br />a shared one.</h2>
        <p>
            Join TeslaMAMA and discover a more connected way
            to travel across Dhaka.
        </p>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Home"
               asp-action="Index"
               class="tm-btn tm-btn-light">
                Welcome to TeslaMAMA
                <span aria-hidden="true">→</span>
            </a>
        }
        else
        {
            <a asp-controller="Account"
               asp-action="Register"
               class="tm-btn tm-btn-light">
                Create your account
                <span aria-hidden="true">→</span>
            </a>
        }
    </div>

    <div class="tm-cta-decoration" aria-hidden="true">TM</div>
</section>

<script>
    // Keep the map zone labels in sync with the pickup/dropoff inputs.
    (function () {
        var pickup = document.getElementById('Pickup');
        var dropoff = document.getElementById('Dropoff');
        var pickupLabel = document.querySelector('.place.p1 b');
        var dropoffLabel = document.querySelector('.place.p2 b');

        if (!pickup || !dropoff || !pickupLabel || !dropoffLabel) return;

        function syncLabels() {
            pickupLabel.textContent = pickup.value.trim() || 'Banani';
            dropoffLabel.textContent = dropoff.value.trim() || 'Mohakhali';
        }

        pickup.addEventListener('input', syncLabels);
        dropoff.addEventListener('input', syncLabels);
        pickup.addEventListener('change', syncLabels);
        dropoff.addEventListener('change', syncLabels);
    })();
</script>

<script>
    // Custom zone picker: the native <datalist> can't reopen the full list
    // after a selection, so we build a filterable dropdown instead.
    // The datalist stays as a no-JS fallback until this runs.
    (function () {
        var datalist = document.getElementById('areas');
        if (!datalist) return;

        var zones = Array.prototype.map.call(datalist.options, function (o) { return o.value; });

        document.querySelectorAll('.mini input').forEach(function (input) {
            var box = input.closest('.mini');
            var list = document.createElement('ul');
            list.className = 'suggest';
            list.hidden = true;
            list.setAttribute('role', 'listbox');
            box.appendChild(list);

            var items = [];
            var active = -1;

            input.setAttribute('role', 'combobox');
            input.setAttribute('aria-expanded', 'false');
            input.setAttribute('aria-autocomplete', 'list');

            function hide() {
                list.hidden = true;
                input.setAttribute('aria-expanded', 'false');
                active = -1;
            }

            function render(filter) {
                var q = filter.trim().toLowerCase();
                var matches = zones.filter(function (z) {
                    return !q || z.toLowerCase().indexOf(q) !== -1;
                });

                list.innerHTML = '';
                items = [];
                active = -1;

                if (!matches.length) { hide(); return; }

                matches.forEach(function (z, i) {
                    var li = document.createElement('li');
                    li.textContent = z;
                    li.setAttribute('role', 'option');
                    li.id = input.id + '-opt-' + i;
                    li.addEventListener('mousedown', function (e) {
                        e.preventDefault();
                        choose(z);
                    });
                    li.addEventListener('click', function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                    });
                    list.appendChild(li);
                    items.push(li);
                });

                list.hidden = false;
                input.setAttribute('aria-expanded', 'true');
            }

            function choose(value) {
                input.value = value;
                input.dispatchEvent(new Event('input', { bubbles: true }));
                hide();
                input.blur();
            }

            function move(step) {
                if (list.hidden) { render(''); return; }
                active = (active + step + items.length) % items.length;
                items.forEach(function (li, i) {
                    li.classList.toggle('is-active', i === active);
                });
                if (active >= 0 && items[active]) {
                    input.setAttribute('aria-activedescendant', items[active].id);
                    items[active].scrollIntoView({ block: 'nearest' });
                }
            }

            input.addEventListener('focus', function () { render(''); });
            input.addEventListener('input', function () { render(input.value); });
            input.addEventListener('blur', hide);

            input.addEventListener('keydown', function (e) {
                if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
                else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
                else if (e.key === 'Enter' && active >= 0 && !list.hidden) {
                    e.preventDefault();
                    choose(items[active].textContent);
                }
                else if (e.key === 'Escape') { hide(); }
            });

            // Custom picker is ready: disable the native datalist popup.
            input.removeAttribute('list');
        });
    })();
</script>
