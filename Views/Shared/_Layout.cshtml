
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - TeslaMAMA</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@700&display=swap" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/TeslaMAMA.styles.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <header class="tm-header">
        <nav class="tm-navbar" aria-label="Main navigation">
            <div class="tm-nav-container">

                <a class="tm-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="tm-brand-icon">T</span>
                    <span class="tm-brand-name">
                        Tesla<span>MAMA</span>
                    </span>
                </a>

                <button class="tm-menu-toggle"
                        type="button"
                        aria-label="Toggle navigation"
                        aria-expanded="false"
                        aria-controls="tm-nav-links">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>

                <div class="tm-nav-links" id="tm-nav-links">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var rawName = User.Identity?.Name ?? "there";
                        var shortName = rawName.Contains('@') ? rawName.Split('@')[0] : rawName.Split(' ')[0];
                        var initial = shortName.Length > 0 ? char.ToUpper(shortName[0]).ToString() : "?";

                        @if (User.IsInRole("Passenger"))
                        {
                            var action = ViewContext.RouteData.Values["action"]?.ToString();
                            <a class="tm-nav-link @(action == "Overview" ? "is-active" : "")"
                               asp-controller="Passenger" asp-action="Overview">Overview</a>

                            <a class="tm-nav-link @(action == "Activity" ? "is-active" : "")"
                               asp-controller="Passenger" asp-action="Activity">Activity</a>

                            <a class="tm-nav-link @(action == "Book" ? "is-active" : "")"
                               asp-controller="Passenger" asp-action="Book">Book a ride</a>

                            <a class="tm-nav-link @(action == "PaymentHistory" ? "is-active" : "")"
                               asp-controller="Passenger" asp-action="PaymentHistory">Payments</a>
                        }

                        @if (User.IsInRole("Driver"))
                        {
                            var action = ViewContext.RouteData.Values["action"]?.ToString();
                            <a class="tm-nav-link @(action == "Index" ? "is-active" : "")"
                               asp-controller="Driver" asp-action="Index">Dashboard</a>
                        }

                        <div class="tm-nav-auth">
                            <span class="tm-user-chip">
                                <span class="tm-avatar">@initial</span>@shortName
                            </span>

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="tm-logout-form">
                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="tm-btn tm-btn-logout">
                                    Log out
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <a class="tm-nav-link"
                           asp-controller="Home"
                           asp-action="Index">Home</a>

                        <a class="tm-nav-link"
                           asp-controller="Home"
                           asp-action="Index"
                           asp-fragment="how-it-works">How it works</a>

                        <div class="tm-nav-auth">
                            <a class="tm-nav-login"
                               asp-controller="Account"
                               asp-action="Login">Sign in</a>

                            <a class="tm-btn tm-btn-primary tm-nav-register"
                               asp-controller="Account"
                               asp-action="Register">Get started</a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <!-- Notification toast container -->
    <div id="tm-notification-container" class="tm-notification-container"></div>

    <footer class="tm-footer">
        <div class="tm-footer-main">
            <div class="tm-footer-brand">
                <a class="tm-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="tm-brand-icon">T</span>
                    <span class="tm-brand-name">
                        Tesla<span>MAMA</span>
                    </span>
                </a>

                <p>
                    A smarter way to share compatible rides
                    across Dhaka.
                </p>
            </div>

            <div class="tm-footer-links">
                <h3>Explore</h3>
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="how-it-works">How it works</a>
                <a asp-controller="Home"
                   asp-action="Privacy">Privacy</a>
            </div>

            <div class="tm-footer-links">
                <h3>Your account</h3>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Home"
                       asp-action="Index"
                       asp-fragment="book-ride">Explore rides</a>
                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="Login">Sign in</a>

                    <a asp-controller="Account"
                       asp-action="Register">Create account</a>
                }
            </div>
        </div>

        <div class="tm-footer-bottom">
            <span>
                &copy; @DateTime.Now.Year TeslaMAMA.
                All rights reserved.
            </span>

            <span>Designed for smarter shared journeys.</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
