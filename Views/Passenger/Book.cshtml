
@using TeslaMAMA.Models
@model PassengerBookingViewModel

@{
    ViewData["Title"] = "Book a Ride";
}

<section class="tm-dashboard">
    <div class="tm-dashboard-header">
        <div>
            <p class="tm-eyebrow">PASSENGER</p>
            <h1>Book your ride</h1>
            <p>Choose your route and request a ride with TeslaMAMA.</p>
        </div>

        <a asp-controller="Passenger"
           asp-action="Dashboard"
           class="tm-btn tm-btn-secondary">
            Back to dashboard
        </a>
    </div>

    <div class="tm-dashboard-panel tm-booking-panel">
        <form asp-controller="Passenger"
              asp-action="Book"
              method="post"
              id="booking-form">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"
                 role="alert"></div>

            <div class="tm-booking-grid">
                <div class="tm-form-field">
                    <label asp-for="PickupZone">Pickup zone</label>
                    <select asp-for="PickupZone" id="pickup-zone">
                        <option value="">Choose pickup</option>
                        @foreach (var zone in Model.SupportedZones)
                        {
                            <option value="@zone">@zone</option>
                        }
                    </select>
                    <span asp-validation-for="PickupZone"
                          class="text-danger"></span>
                </div>

                <div class="tm-form-field">
                    <label asp-for="DestinationZone">
                        Destination zone
                    </label>
                    <select asp-for="DestinationZone"
                            id="destination-zone">
                        <option value="">Choose destination</option>
                        @foreach (var zone in Model.SupportedZones)
                        {
                            <option value="@zone">@zone</option>
                        }
                    </select>
                    <span asp-validation-for="DestinationZone"
                          class="text-danger"></span>
                </div>

                <div class="tm-form-field">
                    <label asp-for="RideType">Ride type</label>
                    <select asp-for="RideType" id="ride-type">
                        <option value="@RideType.SharedPool">
                            Shared Pool
                        </option>
                        <option value="@RideType.Private">
                            Private Ride
                        </option>
                    </select>
                    <span asp-validation-for="RideType"
                          class="text-danger"></span>
                </div>

                <div class="tm-form-field">
                    <label asp-for="Seats">Number of seats</label>
                    <select asp-for="Seats" id="seat-count">
                        @for (var count = 1; count <= 5; count++)
                        {
                            <option value="@count">
                                @count @(count == 1 ? "seat" : "seats")
                            </option>
                        }
                    </select>
                    <span asp-validation-for="Seats"
                          class="text-danger"></span>
                </div>

                <div class="tm-form-field">
                    <label asp-for="PaymentMethod">Payment method</label>
                    <select asp-for="PaymentMethod">
                        <option value="@PaymentMethod.Cash">Cash</option>
                        <option value="@PaymentMethod.Card">Card</option>
                        <option value="@PaymentMethod.MobileBanking">
                            Mobile banking
                        </option>
                    </select>
                    <span asp-validation-for="PaymentMethod"
                          class="text-danger"></span>
                </div>
            </div>

            <div class="tm-fare-preview" aria-live="polite">
                <div>
                    <p class="tm-eyebrow">ESTIMATED FARE</p>
                    <h2 id="fare-amount">Select a supported route</h2>
                    <p id="fare-details">
                        Choose a pickup and destination to see the estimate.
                        The server validates the final fare.
                    </p>
                </div>
            </div>

            <button type="submit" class="tm-btn tm-btn-primary">
                Request ride
            </button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const pickup = document.getElementById("pickup-zone");
            const destination =
                document.getElementById("destination-zone");
            const seats = document.getElementById("seat-count");
            const rideType = document.getElementById("ride-type");
            const amount = document.getElementById("fare-amount");
            const details = document.getElementById("fare-details");

            let currentRequest = null;

            async function updateFare() {
                if (currentRequest) {
                    currentRequest.abort();
                }

                const from = pickup.value;
                const to = destination.value;
                const count = Number(seats.value);
                const type = rideType.value;

                if (!from || !to) {
                    amount.textContent = "Select a supported route";
                    details.textContent =
                        "Choose a pickup and destination to see the estimate.";
                    return;
                }

                if (from === to) {
                    amount.textContent = "Invalid route";
                    details.textContent =
                        "Pickup and destination must be different.";
                    return;
                }

                amount.textContent = "Calculating...";
                details.textContent = "Checking the current fare estimate.";

                currentRequest = new AbortController();

                const params = new URLSearchParams({
                    pickupZone: from,
                    destinationZone: to,
                    seats: String(count),
                    rideType: type
                });

                try {
                    const response = await fetch(
                        '@Url.Action("FareEstimate", "Passenger")' +
                        "?" + params.toString(),
                        {
                            method: "GET",
                            headers: {
                                "Accept": "application/json"
                            },
                            signal: currentRequest.signal
                        }
                    );

                    const result = await response.json();

                    if (!response.ok) {
                        amount.textContent = "Route unavailable";
                        details.textContent = result.message ||
                            "A fare is not configured for this route.";
                        return;
                    }

                    amount.textContent =
                        "৳" + Number(result.totalFare).toFixed(2);

                    const seatText =
                        count === 1 ? " seat" : " seats";

                    if (type === "SharedPool") {
                        details.textContent =
                            "Shared Pool · " +
                            result.discountPercent +
                            "% discount · ৳" +
                            Number(result.perSeatFare).toFixed(2) +
                            " per seat × " + count + seatText + ".";
                    } else {
                        details.textContent =
                            "Private Ride · Entire vehicle reserved · ৳" +
                            Number(result.perSeatFare).toFixed(2) +
                            " per seat × " + count + seatText +
                            ". No pool discount.";
                    }
                } catch (error) {
                    if (error.name === "AbortError") {
                        return;
                    }

                    amount.textContent = "Fare unavailable";
                    details.textContent =
                        "Could not retrieve the estimate. Please try again.";
                }
            }

            pickup.addEventListener("change", updateFare);
            destination.addEventListener("change", updateFare);
            seats.addEventListener("change", updateFare);
            rideType.addEventListener("change", updateFare);

            updateFare();
        })();
    </script>
}
