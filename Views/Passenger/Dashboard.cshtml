
@model TeslaMAMA.Models.PassengerDashboardViewModel

@{
    ViewData["Title"] = "Passenger Dashboard";
}

<div class="tm-dashboard">
    <div class="tm-dashboard-header">
        <div>
            <span class="tm-dashboard-eyebrow">PASSENGER PORTAL</span>
            <h1>Welcome back, @Model.FullName</h1>
            <p>Manage your ride activity and keep track of your journeys.</p>
        </div>

        <a asp-controller="Home"
           asp-action="Index"
           asp-fragment="how-it-works"
           class="tm-btn tm-btn-primary">
            Explore ride pooling
        </a>
    </div>

    <div class="tm-dashboard-booking-action">
        <a asp-controller="Passenger"
           asp-action="Book"
           class="tm-btn tm-btn-primary">
            Book a ride
        </a>
    </div>

    @if (TempData["BookingSuccess"] is string bookingSuccess)
    {
        <div class="tm-dashboard-note" role="status">
            @bookingSuccess
        </div>
    }

    @if (TempData["Error"] is string errorMessage)
    {
        <div class="tm-dashboard-note" role="alert">
            @errorMessage
        </div>
    }

    <section class="tm-dashboard-stats" aria-label="Ride statistics">
        <article class="tm-stat-card">
            <div class="tm-stat-icon">↗</div>
            <p>Total rides</p>
            <h2>@Model.TotalRides</h2>
            <span>All your ride requests</span>
        </article>

        <article class="tm-stat-card">
            <div class="tm-stat-icon tm-stat-icon-teal">◷</div>
            <p>Active rides</p>
            <h2>@Model.ActiveRides</h2>
            <span>Requests in progress</span>
        </article>

        <article class="tm-stat-card">
            <div class="tm-stat-icon tm-stat-icon-blue">✓</div>
            <p>Completed rides</p>
            <h2>@Model.CompletedRides</h2>
            <span>Successfully completed</span>
        </article>

        <article class="tm-stat-card">
            <div class="tm-stat-icon tm-stat-icon-gold">৳</div>
            <p>Total spent</p>
            <h2>৳@Model.TotalSpent.ToString("N2")</h2>
            <span>Completed rides only</span>
        </article>
    </section>

    <section class="tm-dashboard-panel">
        <div class="tm-panel-header">
            <div>
                <h2>Recent rides</h2>
                <p>Your five most recent ride requests.</p>
            </div>

            <span class="tm-record-count">
                @Model.RecentRides.Count records
            </span>
        </div>

        @if (Model.RecentRides.Count == 0)
        {
            <div class="tm-dashboard-empty">
                <div class="tm-empty-icon">↗</div>
                <h3>Your journey starts here</h3>
                <p>
                    You haven't requested a ride yet. Your ride activity
                    will appear here once you start using TeslaMAMA.
                </p>

                <a asp-controller="Home"
                   asp-action="Index"
                   asp-fragment="how-it-works"
                   class="tm-btn tm-btn-primary">
                    Learn how it works
                </a>
            </div>
        }
        else
        {
            <div class="tm-rides-table-wrapper">
                <table class="tm-rides-table">
                    <thead>
                        <tr>
                            <th>Ride</th>
                            <th>Route</th>
                            <th>Seats</th>
                            <th>Status</th>
                            <th>Fare</th>
                            <th>Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var ride in Model.RecentRides)
                        {
                            <tr>
                                <td>
                                    <strong>#@ride.Id</strong>
                                    <span class="tm-table-subtext">
                                        @ride.PaymentMethod
                                    </span>
                                </td>

                                <td>
                                    <div class="tm-table-route">
                                        <span>@ride.PickupZone</span>
                                        <span class="tm-route-arrow">→</span>
                                        <span>@ride.DestinationZone</span>
                                    </div>

                                    @if (ride.PoolId.HasValue)
                                    {
                                        <span class="tm-table-subtext">
                                            @(ride.IsSharedPool ? "Shared Pool" : "Private Pool") · #@ride.PoolId
                                        </span>

                                        @if (ride.VehicleCapacity.HasValue)
                                        {
                                            <span class="tm-table-subtext">
                                                Seats: @ride.PoolSeatsUsed/@ride.VehicleCapacity
                                            </span>
                                        }

                                        @if (ride.OtherPassengersInPool.HasValue && ride.OtherPassengersInPool > 0)
                                        {
                                            <span class="tm-table-subtext">
                                                +@ride.OtherPassengersInPool other @(ride.OtherPassengersInPool == 1 ? "passenger" : "passengers")
                                            </span>
                                        }

                                        @if (ride.PoolStatus.HasValue)
                                        {
                                            <span class="tm-table-subtext">
                                                Pool: @ride.PoolStatus
                                            </span>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(ride.VehicleName))
                                        {
                                            <span class="tm-table-subtext">
                                                Vehicle: @ride.VehicleName
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="tm-table-subtext">
                                            @(ride.Status == RideStatus.Cancelled
                                                ? "Cancelled"
                                                : ride.Status == RideStatus.NoDriverAvailable
                                                    ? "No driver available"
                                                    : ride.IsSharedPool ? "Waiting for pool match" : "Waiting for driver")
                                        </span>
                                    }
                                </td>

                                <td>@ride.Seats</td>

                                <td>
                                    @if (ride.Status == RideStatus.Requested)
                                    {
                                        <div class="tm-status tm-status-requested tm-status-timer"
                                             data-ride-id="@ride.Id"
                                             data-created-at="@ride.CreatedAt.ToString("o")">
                                            <svg viewBox="0 0 200 40" preserveAspectRatio="none">
                                                <rect class="tm-status-border-bg" x="1" y="1" width="198" height="38" rx="19" ry="19" />
                                                <rect class="tm-status-border-progress" x="1" y="1" width="198" height="38" rx="19" ry="19" />
                                            </svg>
                                            <span class="tm-status-content">Requested</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="tm-status tm-status-@ride.Status.ToString().ToLowerInvariant()">
                                            @(ride.Status == RideStatus.DriverArrived
                                                ? "Driver arrived"
                                                : ride.Status == RideStatus.WaitingForPayment
                                                    ? "Waiting for payment"
                                                    : ride.Status == RideStatus.NoDriverAvailable
                                                        ? "No driver available"
                                                        : ride.Status.ToString())
                                        </span>
                                    }
                                </td>

                                <td>
                                    <strong>৳@ride.FinalFare.ToString("N2")</strong>
                                </td>

                                <td>
                                    <span class="tm-date">
                                        @ride.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                    </span>
                                    <span class="tm-table-subtext">
                                        @ride.CreatedAt.ToLocalTime().ToString("hh:mm tt")
                                    </span>
                                </td>

                                <td>
                                    @if (ride.Status == RideStatus.WaitingForPayment)
                                    {
                                        <form asp-controller="Passenger"
                                              asp-action="ConfirmPayment"
                                              method="post">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="rideId"
                                                   value="@ride.Id" />

                                            <button type="submit"
                                                    class="tm-btn tm-btn-primary">
                                                Confirm Payment
                                            </button>
                                        </form>
                                    }
                                    else if (ride.Status == RideStatus.Completed)
                                    {
                                        <span class="tm-status tm-status-completed">
                                            Completed
                                        </span>
                                    }
                                    else if (ride.Status == RideStatus.Cancelled)
                                    {
                                        <span class="tm-status tm-status-cancelled">
                                            Cancelled
                                        </span>
                                    }
                                    else if (ride.Status == RideStatus.Requested ||
                                             ride.Status == RideStatus.Matched ||
                                             ride.Status == RideStatus.DriverArrived)
                                    {
                                        <form asp-controller="Passenger"
                                              asp-action="CancelRide"
                                              method="post"
                                              onsubmit="return confirm('Are you sure you want to cancel this ride?');">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="rideId"
                                                   value="@ride.Id" />

                                            <button type="submit"
                                                    class="tm-btn tm-btn-danger">
                                                Cancel Ride
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="tm-table-subtext">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <div class="tm-dashboard-note">
        <span class="tm-note-icon">i</span>
        <p>
            <strong>What's next?</strong>
            Track your ride status here. Once the driver reaches your
            destination, confirm payment to complete your ride.
        </p>
    </div>
</div>


@section Scripts {
    <script>
        (() => {
            const TIMER_DURATION = 60; // 1 minute in seconds
            const WARNING_THRESHOLD = 30; // 30 seconds remaining
            const CRITICAL_THRESHOLD = 10; // 10 seconds remaining
            const timers = document.querySelectorAll('.tm-status-timer');
            const notifiedRides = new Set();
            const intervals = new Map();

            // Calculate perimeter of rounded rectangle
            // SVG viewBox: 200x40, rect: 198x38 with 19px radius
            // Perimeter = 2 * (width + height) - 8 * radius + 2 * PI * radius
            const RECT_WIDTH = 198;
            const RECT_HEIGHT = 38;
            const RECT_RADIUS = 19;
            const PERIMETER = 2 * (RECT_WIDTH + RECT_HEIGHT) - 8 * RECT_RADIUS + 2 * Math.PI * RECT_RADIUS;

            function updateTimer(timerElement) {
                const createdAt = new Date(timerElement.dataset.createdAt);
                const rideId = timerElement.dataset.rideId;
                const elapsed = (Date.now() - createdAt.getTime()) / 1000;
                const remaining = Math.max(0, TIMER_DURATION - elapsed);
                const percentage = (remaining / TIMER_DURATION) * 100;

                const progress = timerElement.querySelector('.tm-status-border-progress');

                if (progress) {
                    const dashOffset = PERIMETER * (1 - percentage / 100);
                    progress.style.strokeDasharray = PERIMETER;
                    progress.style.strokeDashoffset = dashOffset;
                }

                if (remaining <= CRITICAL_THRESHOLD) {
                    timerElement.dataset.state = 'critical';
                } else if (remaining <= WARNING_THRESHOLD) {
                    timerElement.dataset.state = 'warning';
                } else {
                    delete timerElement.dataset.state;
                }

                if (remaining <= 0 && !notifiedRides.has(rideId)) {
                    notifiedRides.add(rideId);
                    if (typeof showNotification === 'function') {
                        showNotification(
                            'Taking longer than expected',
                            'Sorry for the wait. It seems no drivers are available in your area right now. Please try a different pickup zone or cancel and try again later.',
                            'error'
                        );
                    }
                }

                if (remaining <= 0) {
                    const intervalId = intervals.get(rideId);
                    if (intervalId) {
                        clearInterval(intervalId);
                        intervals.delete(rideId);
                    }
                }
            }

            if (timers.length > 0) {
                timers.forEach(timer => {
                    updateTimer(timer);
                    const rideId = timer.dataset.rideId;
                    const intervalId = setInterval(() => updateTimer(timer), 1000);
                    intervals.set(rideId, intervalId);
                });
            }

            // Cleanup intervals when page unloads
            window.addEventListener('beforeunload', () => {
                intervals.forEach(intervalId => clearInterval(intervalId));
            });
        })();
    </script>
}
