@model TeslaMAMA.Models.AdminRidesViewModel

@{
    ViewData["Title"] = "Manage Rides";
}

<section class="tm-dashboard">
    <!-- Header -->
    <div class="tm-dashboard-header">
        <div>
            <p class="tm-eyebrow">ADMIN</p>
            <h1>Manage Rides</h1>
            <p>View and manage all ride requests</p>
        </div>
        <a asp-action="Index" class="tm-btn tm-btn-secondary">Back to Dashboard</a>
    </div>

    <!-- Filters -->
    <div class="tm-filters">
        <form asp-action="Rides" method="get" class="tm-filter-form">
            <select name="status" class="tm-select">
                <option value="">All Statuses</option>
                <option value="Requested" selected="@(Model.StatusFilter == "Requested")">Requested</option>
                <option value="Matched" selected="@(Model.StatusFilter == "Matched")">Matched</option>
                <option value="DriverArrived" selected="@(Model.StatusFilter == "DriverArrived")">Driver Arrived</option>
                <option value="Started" selected="@(Model.StatusFilter == "Started")">Started</option>
                <option value="WaitingForPayment" selected="@(Model.StatusFilter == "WaitingForPayment")">Waiting for Payment</option>
                <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Completed</option>
                <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
                <option value="NoDriverAvailable" selected="@(Model.StatusFilter == "NoDriverAvailable")">No Driver Available</option>
            </select>
            <button type="submit" class="tm-btn tm-btn-primary">Filter</button>
            <a asp-action="Rides" class="tm-link">Clear</a>
        </form>
    </div>

    <!-- Rides Table -->
    <div class="tm-table-container">
        <table class="tm-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Passenger</th>
                    <th>Driver</th>
                    <th>Route</th>
                    <th>Status</th>
                    <th>Fare</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Rides.Any())
                {
                    @foreach (var ride in Model.Rides)
                    {
                        <tr>
                            <td>#@ride.Id</td>
                            <td>@ride.PassengerName</td>
                            <td>@ride.DriverName ?? "Unassigned"</td>
                            <td>@ride.PickupZone → @ride.DestinationZone</td>
                            <td>
                                <span class="tm-status-badge tm-status-@ride.Status.ToString().ToLower()">
                                    @ride.Status
                                </span>
                            </td>
                            <td><span class="tm-taka">৳</span>@ride.Fare.ToString("N2")</td>
                            <td>@ride.CreatedAt.ToString("MMM dd, HH:mm")</td>
                            <td>
                                <a asp-action="RideDetails" asp-route-id="@ride.Id" class="tm-btn tm-btn-sm tm-btn-outline">View Details</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="tm-empty-cell">No rides found</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="tm-pagination">
            @if (Model.CurrentPage > 1)
            {
                <a asp-action="Rides" asp-route-page="@(Model.CurrentPage - 1)" asp-route-status="@Model.StatusFilter" class="tm-btn tm-btn-outline">Previous</a>
            }

            <span>Page @Model.CurrentPage of @Model.TotalPages</span>

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a asp-action="Rides" asp-route-page="@(Model.CurrentPage + 1)" asp-route-status="@Model.StatusFilter" class="tm-btn tm-btn-outline">Next</a>
            }
        </div>
    }
</section>
