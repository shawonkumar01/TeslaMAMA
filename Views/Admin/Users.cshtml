@model TeslaMAMA.Models.AdminUsersViewModel

@{
    ViewData["Title"] = "Manage Users";
}

<section class="tm-dashboard">
    <!-- Header -->
    <div class="tm-dashboard-header">
        <div>
            <p class="tm-eyebrow">ADMIN</p>
            <h1>Manage Users</h1>
            <p>View and manage platform users</p>
        </div>
        <a asp-action="Index" class="tm-btn tm-btn-secondary">Back to Dashboard</a>
    </div>

    <!-- Filters -->
    <div class="tm-filters">
        <form asp-action="Users" method="get" class="tm-filter-form">
            <input type="text" name="search" placeholder="Search by name, email, or username" value="@Model.Search" class="tm-input" />
            <select name="role" class="tm-select">
                <option value="">All Roles</option>
                <option value="Passenger" selected="@(Model.RoleFilter == "Passenger")">Passenger</option>
                <option value="Driver" selected="@(Model.RoleFilter == "Driver")">Driver</option>
                <option value="Admin" selected="@(Model.RoleFilter == "Admin")">Admin</option>
            </select>
            <button type="submit" class="tm-btn tm-btn-primary">Filter</button>
            <a asp-action="Users" class="tm-link">Clear</a>
        </form>
    </div>

    <!-- Users Table -->
    <div class="tm-table-container">
        <table class="tm-table">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Username</th>
                    <th>Role</th>
                    <th>Joined</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Users.Any())
                {
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td>
                                <div class="tm-user-cell">
                                    <span class="tm-avatar-sm">@((user.FullName?.FirstOrDefault() ?? user.UserName?.FirstOrDefault() ?? '?').ToString().ToUpper())</span>
                                    <span>@user.FullName ?? "N/A"</span>
                                </div>
                            </td>
                            <td>@user.Email</td>
                            <td>@user.UserName</td>
                            <td>
                                <span class="tm-role-badge tm-role-@user.Role.ToString().ToLower()">
                                    @user.Role
                                </span>
                            </td>
                            <td>@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                <span class="tm-status-badge tm-status-active">Active</span>
                            </td>
                            <td>
                                <form asp-action="ToggleUserStatus" method="post" style="display: inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <button type="submit" class="tm-btn tm-btn-sm tm-btn-outline">Toggle Status</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="tm-empty-cell">No users found</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="tm-pagination">
            @if (Model.CurrentPage > 1)
            {
                <a asp-action="Users" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.Search" asp-route-role="@Model.RoleFilter" class="tm-btn tm-btn-outline">Previous</a>
            }

            <span>Page @Model.CurrentPage of @Model.TotalPages</span>

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a asp-action="Users" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.Search" asp-route-role="@Model.RoleFilter" class="tm-btn tm-btn-outline">Next</a>
            }
        </div>
    }
</section>
